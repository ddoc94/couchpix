{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "netpix-app.vercel.app" }],
      "destination": "https://couchpix.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "netpix-app.vercel.app" }],
      "destination": "https://couchpix.com/:path*",
      "permanent": true
    }
  ]
}
